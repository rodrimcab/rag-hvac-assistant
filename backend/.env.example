APP_NAME="RAG HVAC Assistant API"
DEBUG=false
# Comma-separated origins for the Vite dev server (and production URLs when applicable)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google API keys — https://aistudio.google.com/apikey
# Paid / Tier 1 (primary): higher RPM for embeddings and vision during ingestion.
GOOGLE_API_KEY=
# Free tier (fallback): used when GOOGLE_API_KEY is unset or hits quota (429).
# Also applies free-tier throttling defaults (smaller embedding batches, vision pacing).
GOOGLE_API_KEY_FREE=

# ── LLM ──────────────────────────────────────────────────────────────────────
# Gemini 1.5 Pro retired from consumer API (404 on new projects post-2025-Q1).
# Gemini 2.5 Pro requires paid tier (Free quota = 0 on new projects).
# Default: most capable model available on Free tier.
# GEMINI_LLM_MODEL=models/gemini-2.5-flash
# GEMINI_LLM_TEMPERATURE=0.1

# ── Embeddings ───────────────────────────────────────────────────────────────
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Tier 1 (paid key): max throughput (100 texts per request).
# EMBEDDING_BATCH_SIZE=100
# EMBEDDING_MIN_INTERVAL_SECONDS=0
# Free tier (no paid key, or GOOGLE_API_KEY_FREE only):
# FREE_EMBEDDING_BATCH_SIZE=5
# FREE_EMBEDDING_MIN_INTERVAL_SECONDS=12.0

# ── Chunking (winning config for HVAC service manuals) ───────────────────────
# MANUALS_DIR=data/manuals
# RAG_CHUNK_SIZE=1024
# RAG_CHUNK_OVERLAP=200
# RAG_MIN_NODE_TEXT_CHARS=12

# ── Retrieval ─────────────────────────────────────────────────────────────────
# top_k is set dynamically per query intent (diagnosis vs error_code).
# RAG_DIAGNOSIS_TOP_K=5        # complex queries → tree_summarize
# RAG_ERROR_CODE_TOP_K=3       # code lookups   → compact
# Omit document «sources» in JSON unless the question looks like a manual/HVAC query
# and each chunk clears these similarity gates (LlamaIndex: exp(-Chroma distance)).
# RAG_SOURCE_SCORE_FLOOR=0.515
# RAG_SOURCE_SCORE_MARGIN_FROM_TOP=0.035

# ── ChromaDB persistence ──────────────────────────────────────────────────────
# CHROMA_DB_PATH=data/chroma_db
# CHROMA_COLLECTION_NAME=hvac_manuals

# SQLite — historial de chat (ruta relativa a `backend/`)
# CONVERSATIONS_DB_PATH=data/conversations.db
#
# Demo multi-cuenta: el frontend envía la cabecera HTTP `X-Demo-User` (p. ej. default, usuario-1).
# Sin cabecera el API usa owner_id=default. No sustituye autenticación real.

# ── Diagram vision (ingestion only; re-upload or re-index PDFs to apply) ─────
# DIAGRAM_VISION_ENABLED=true
# GEMINI_VISION_MODEL=gemini-2.5-flash
# DIAGRAM_VISION_MAX_PAGES_PER_PDF=10
# DIAGRAM_VISION_MIN_INTERVAL_SECONDS=0
# FREE_DIAGRAM_VISION_MAX_PAGES_PER_PDF=45
# FREE_DIAGRAM_VISION_MIN_INTERVAL_SECONDS=2.0
# DIAGRAM_SKIP_VISION_MIN_TEXT_CHARS=2600
# DIAGRAM_VISION_MIN_DRAWINGS=150
